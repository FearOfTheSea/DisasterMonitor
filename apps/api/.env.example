APP_NAME=Disaster Monitor API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_TOKENS=512

# Bounded specialist analysis reuses OLLAMA_MODEL sequentially. Keep disabled to
# preserve the deterministic coordination baseline.
SPECIALIST_LLM_ENABLED=false
SPECIALIST_MODEL_CALL_LIMIT=2

# Typed historical context is separate from transcripts and operational evidence.
LONG_TERM_MEMORY_ENABLED=false
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_VISION_TIMEOUT_SECONDS=180
OLLAMA_VISION_MAX_TOKENS=384
DISASTER_PROVIDER_TIMEOUT_SECONDS=10
GDACS_PROVIDER_TIMEOUT_SECONDS=30
DISASTER_PROVIDER_MAX_RESPONSE_BYTES=1000000

# Event-focused Sentinel-1/Sentinel-2 Ground view. Public CDSE STAC discovery is
# available without credentials; authenticated Process rendering and COG
# preparation require a CDSE OAuth client. Keep these values server-side.
GROUND_IMAGERY_ENABLED=true
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
GROUND_IMAGERY_CATALOG_MAX_RESPONSE_BYTES=8000000
GROUND_IMAGERY_PROCESS_MAX_RESPONSE_BYTES=134217728
GROUND_IMAGERY_STORAGE_ROOT=data/ground-imagery
GROUND_IMAGERY_STORAGE_BUDGET_BYTES=21474836480
GROUND_IMAGERY_JOB_LEASE_SECONDS=300
GROUND_IMAGERY_BUDGET_UNITS_PER_HOUR=100
GROUND_IMAGERY_RETENTION_DAYS=30

# Event-linked source photos. These defaults work without an API key. Discovery is
# fail-soft: report generation continues when no photo passes the association gates.
EVENT_MEDIA_ENABLED=true
EVENT_MEDIA_TARGET_COUNT=3
EVENT_MEDIA_CANDIDATE_LIMIT=12
EVENT_MEDIA_MAX_IMAGE_BYTES=3000000
EVENT_MEDIA_STORE_MAXIMUM_BYTES=24000000

# Optional supplementary humanitarian reports. Leave unset to disable ReliefWeb.
# RELIEFWEB_APP_NAME=

# Optional humanitarian context. HDX requires an application identifier. IOM DTM is
# disabled unless both its approved API URL and subscription key are configured.
# HDX_HAPI_APP_IDENTIFIER=
# IOM_DTM_API_URL=https://api.dtm.iom.int/v3/displacement
# IOM_DTM_SUBSCRIPTION_KEY=

# Durable local unverified field reports and explicitly non-evidence operator state.
FIELD_REPORT_STORE_PATH=data/field-reports/reports.json
FIELD_MEDIA_ROOT=data/field-reports/media
FIELD_MEDIA_RETENTION_DAYS=30
FIELD_MEDIA_MAXIMUM_BYTES=100000000
OPERATOR_WORKSPACE_STORE_PATH=data/operator-workspace/workspace.json

# Optional local-only route visualization. Both values are required. Public routing
# services are rejected and results are never evacuation or safety guidance.
# SELF_HOSTED_OSRM_URL=http://127.0.0.1:5000
# SELF_HOSTED_OSRM_DATA_VERSION=geofabrik-YYYY-MM-DD

# Optional free NASA FIRMS map key for selected-wildfire thermal observations.
# Leave unset to disable FIRMS without making a request.
# NASA_FIRMS_MAP_KEY=

# Durable operational history. Leave the database URL empty for the in-process
# development fallback; Compose configures PostgreSQL automatically.
# OPERATIONAL_DATABASE_URL=
OPERATIONAL_BLOB_ROOT=data/operational/blobs
OPERATIONAL_AUTO_MIGRATE=true

# Autonomous global country metadata. The API catches up once when no successful
# update exists for the current month, then runs at 00:00 UTC on each first day.
COUNTRY_CATALOG_ROOT=data/geography
COUNTRY_CATALOG_AUTOMATIC_UPDATES=true
COUNTRY_CATALOG_UPDATE_TIMEOUT_SECONDS=60
COUNTRY_CATALOG_MAX_RESPONSE_BYTES=10000000
COUNTRY_CATALOG_RETRY_HOURS=6

# Enable only behind a trusted reverse proxy that strips and injects this header.
TRUSTED_OPERATOR_IDENTITY_ENABLED=false
TRUSTED_OPERATOR_IDENTITY_HEADER=x-disastermonitor-operator
