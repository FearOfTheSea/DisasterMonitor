APP_NAME=Disaster Monitor API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_TOKENS=512
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_VISION_TIMEOUT_SECONDS=180
OLLAMA_VISION_MAX_TOKENS=384
DISASTER_PROVIDER_TIMEOUT_SECONDS=10
DISASTER_PROVIDER_MAX_RESPONSE_BYTES=1000000

# Optional credential-protected satellite imagery. Sentinel Hub must have the
# named WMS layer configured; Planet serves one accessible mosaic, not scene search.
# COPERNICUS_SENTINEL_HUB_INSTANCE_ID=
COPERNICUS_SENTINEL_HUB_LAYER_ID=TRUE_COLOR
# PLANET_API_KEY=
# PLANET_MOSAIC_NAME=

# Event-linked source photos. These defaults work without an API key. Discovery is
# fail-soft: report generation continues when no photo passes the association gates.
EVENT_MEDIA_ENABLED=true
EVENT_MEDIA_TARGET_COUNT=3
EVENT_MEDIA_CANDIDATE_LIMIT=12
EVENT_MEDIA_MAX_IMAGE_BYTES=3000000
EVENT_MEDIA_STORE_MAXIMUM_BYTES=24000000

# Optional supplementary humanitarian reports. Leave unset to disable ReliefWeb.
# RELIEFWEB_APP_NAME=

# Optional free NASA FIRMS map key for selected-wildfire thermal observations.
# Leave unset to disable FIRMS without making a request.
# NASA_FIRMS_MAP_KEY=

# Durable operational history. Leave the database URL empty for the in-process
# development fallback; Compose configures PostgreSQL automatically.
# OPERATIONAL_DATABASE_URL=
OPERATIONAL_BLOB_ROOT=data/operational/blobs
OPERATIONAL_AUTO_MIGRATE=true

# Autonomous global country metadata. The API catches up once when no successful
# update exists for the current month, then runs at 00:00 UTC on each first day.
COUNTRY_CATALOG_ROOT=data/geography
COUNTRY_CATALOG_AUTOMATIC_UPDATES=true
COUNTRY_CATALOG_UPDATE_TIMEOUT_SECONDS=60
COUNTRY_CATALOG_MAX_RESPONSE_BYTES=10000000
COUNTRY_CATALOG_RETRY_HOURS=6

# Enable only behind a trusted reverse proxy that strips and injects this header.
TRUSTED_OPERATOR_IDENTITY_ENABLED=false
TRUSTED_OPERATOR_IDENTITY_HEADER=x-disastermonitor-operator
